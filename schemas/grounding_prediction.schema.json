{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThaiVoice-GUIBench grounding prediction record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prediction_id",
    "utterance_id",
    "audio_id",
    "screen_id",
    "target_element_id",
    "grounding_model",
    "input_condition",
    "asr_model",
    "transcript_source",
    "transcript",
    "pred_x",
    "pred_y",
    "pred_label",
    "confidence",
    "status",
    "failure_type",
    "error_message",
    "latency_ms",
    "raw_response_path",
    "created_at",
    "params"
  ],
  "properties": {
    "prediction_id": {"type": "string", "minLength": 1},
    "utterance_id": {"type": "string", "minLength": 1},
    "audio_id": {"type": ["string", "null"]},
    "screen_id": {"type": "string", "minLength": 1},
    "target_element_id": {"type": "string", "minLength": 1},
    "grounding_model": {"type": "string", "minLength": 1},
    "input_condition": {
      "type": "string",
      "enum": [
        "gold",
        "asr_whisper_large_v3_local",
        "asr_typhoon_asr_api",
        "corrected_A_no_screen_cleanup_whisper",
        "corrected_B_screen_string_match_whisper",
        "corrected_C_full_screen_aware_alias_whisper",
        "corrected_A_no_screen_cleanup_typhoon",
        "corrected_B_screen_string_match_typhoon",
        "corrected_C_full_screen_aware_alias_typhoon"
      ]
    },
    "asr_model": {"type": ["string", "null"]},
    "transcript_source": {"type": "string", "minLength": 1},
    "transcript": {"type": "string"},
    "pred_x": {"type": ["number", "null"]},
    "pred_y": {"type": ["number", "null"]},
    "pred_label": {"type": "string"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "status": {"type": "string", "enum": ["success", "failed", "skipped"]},
    "failure_type": {"type": ["string", "null"]},
    "error_message": {"type": "string"},
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "raw_response_path": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "params": {"type": "object"}
  }
}
