{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThaiVoice-GUIBench correction output record",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "correction_id",
    "utterance_id",
    "audio_id",
    "screen_id",
    "asr_model",
    "method",
    "input_transcript",
    "corrected_transcript",
    "changed",
    "matched_screen_label",
    "match_score",
    "confidence",
    "correction_reason",
    "tier",
    "domain",
    "language_class",
    "tts_engine",
    "voice_id",
    "status",
    "error_message"
  ],
  "properties": {
    "correction_id": {
      "type": "string",
      "minLength": 1
    },
    "asr_id": {
      "type": "string",
      "minLength": 1
    },
    "utterance_id": {
      "type": "string",
      "minLength": 1
    },
    "audio_id": {
      "type": "string",
      "minLength": 1
    },
    "screen_id": {
      "type": "string",
      "minLength": 1
    },
    "asr_model": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "enum": [
        "A_no_screen_cleanup",
        "B_screen_string_match",
        "C_full_screen_aware_alias"
      ]
    },
    "input_transcript": {
      "type": "string"
    },
    "corrected_transcript": {
      "type": "string"
    },
    "changed": {
      "type": "boolean"
    },
    "matched_screen_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "match_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "correction_reason": {
      "type": "string"
    },
    "tier": {
      "type": "string",
      "enum": [
        "T1_verbatim",
        "T2_paraphrase",
        "T3_intent",
        "T4_visual_positional"
      ]
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "language_class": {
      "type": "string",
      "minLength": 1
    },
    "tts_engine": {
      "type": "string",
      "minLength": 1
    },
    "voice_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "skipped"
      ]
    },
    "error_message": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original_span",
          "corrected_span",
          "source",
          "score",
          "reason"
        ],
        "properties": {
          "original_span": {
            "type": "string"
          },
          "corrected_span": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "params": {
      "type": "object"
    }
  }
}
