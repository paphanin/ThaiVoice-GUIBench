{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thaivoice-guibench.local/intent_screen_target.schema.json",
  "title": "ThaiVoice-GUIBench Intent Screen Target Mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_id",
    "intent_id",
    "screen_id",
    "target_element_id",
    "distractor_element_ids",
    "difficulty",
    "notes"
  ],
  "properties": {
    "mapping_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "screen_id": {
      "type": "string",
      "minLength": 1
    },
    "target_element_id": {
      "type": "string",
      "minLength": 1
    },
    "distractor_element_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "notes": {
      "type": "string"
    }
  }
}
