{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thaivoice-guibench.local/intent.schema.json",
  "title": "ThaiVoice-GUIBench Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent_id",
    "domain",
    "canonical_en",
    "canonical_th",
    "description",
    "allowed_tiers",
    "semantic_keywords_th",
    "semantic_keywords_en",
    "notes"
  ],
  "properties": {
    "intent_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "domain": {
      "type": "string",
      "enum": ["mock_finance", "shopping", "settings", "messaging"]
    },
    "canonical_en": {
      "type": "string",
      "minLength": 1
    },
    "canonical_th": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "allowed_tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "T1_verbatim",
          "T2_paraphrase",
          "T3_intent",
          "T4_visual_positional"
        ]
      },
      "uniqueItems": true
    },
    "semantic_keywords_th": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "semantic_keywords_en": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  }
}
