{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thaivoice-guibench.local/audio_manifest.schema.json",
  "title": "ThaiVoice-GUIBench Audio Manifest Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audio_id",
    "utterance_id",
    "split",
    "engine_id",
    "voice_id",
    "provider_voice",
    "provider_model",
    "text",
    "text_sha256",
    "audio_path",
    "format",
    "sample_rate_hz",
    "duration_ms",
    "synthesis_mode",
    "created_at"
  ],
  "properties": {
    "audio_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+__[a-z0-9_]+__(dev|test)__[a-z0-9_]+_t[1-4]_[a-z_]+_[0-9]{2}$"
    },
    "utterance_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "type": "string",
      "enum": ["dev", "test"]
    },
    "engine_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "voice_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "provider_voice": {
      "type": "string",
      "minLength": 1
    },
    "provider_model": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_path": {
      "type": "string",
      "pattern": "^.+\\.wav$"
    },
    "format": {
      "type": "string",
      "const": "wav"
    },
    "include_in_experiments": {
      "type": "boolean"
    },
    "generation_status": {
      "type": "string",
      "enum": ["planned", "success", "failed_generation"]
    },
    "error_message": {
      "type": "string"
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 8000
    },
    "duration_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "synthesis_mode": {
      "type": "string",
      "enum": ["dry_run", "real"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
